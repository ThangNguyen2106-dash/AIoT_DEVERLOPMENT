{
  "name": "AIoT_Lib",
  "version": "2.0.0",
  "description": "High-performance Hybrid AI framework for ESP32 and ESP32-S3 with Edge AI pipeline, adaptive NVS Flash, HiveMQ Cloud TLS, and Google Gemini Cloud AI.",
  "keywords": [
    "aiot",
    "hybrid-ai",
    "edge-ai",
    "esp32",
    "esp32-s3",
    "hivemq",
    "gemini",
    "kalman",
    "mqtt",
    "captive-portal",
    "telemetry"
  ],
  "authors": [
    {
      "name": "AIoT Development Community"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ThangNguyen2106-dash/AIoT_DEVERLOPMENT.git"
  },
  "frameworks": "arduino",
  "platforms": "espressif32",
  "headers": "AIoT.h",
  "build": {
    "srcFilter": [
      "+<*>",
      "-<main.cpp>",
      "-<secrets.h>"
    ]
  },
  "examples": "examples/*/*.ino"
}
